+def _final_layer_forward(original_forward):
+    def forward(self, x, t_emb, *args, **kwargs):
+        # FP32 modulation for the output heads (audio_out/video_out are already
+        # the checkpoint's FP32 island); only the tiny adaLN projection changes.
+        if torch.is_tensor(x) and x.dtype != torch.float32:
+            x = x.to(torch.float32)
+        if torch.is_tensor(t_emb) and t_emb.dtype != torch.float32:
+            t_emb = t_emb.to(torch.float32)
+        return original_forward(x, t_emb, *args, **kwargs)
+
+    return forward
+
+
+def _inner_forward(original_forward):
+    def forward(self, x, timestep, context, transformer_options={}, *args, **kwargs):
+        # Undo the FP32 carrier right at the native H3 core so the packed
+        # sequence, t_emb and RoPE table keep the protected FP16 policy.
+        inner_dtype = None
+        if isinstance(transformer_options, dict):
+            inner_dtype = transformer_options.get(INNER_CONTEXT_DTYPE_KEY)
+        if inner_dtype is not None and torch.is_tensor(context) and context.dtype != inner_dtype:
+            context = context.to(dtype=inner_dtype)
+        return original_forward(x, timestep, context, transformer_options, *args, **kwargs)
+
+    return forward
+
+
+def _to_fp32_carrier(value):
+    if torch.is_tensor(value):
+        return value.to(torch.float32) if value.is_floating_point() and value.dtype != torch.float32 else value
+    if isinstance(value, (list, tuple)):
+        return type(value)(_to_fp32_carrier(item) for item in value)
+    return value
+
